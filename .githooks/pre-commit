#!/bin/bash
# Pre-commit hook: security scanning + spec validation
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Validation Modes:
# - STRICT=1 : All gates must pass (enforced on main)
# - STRICT=0 : Warnings only, advisory (default for development)
#
# Configure with: STRICT=1 git commit OR git config hooks.specValidationStrict true

set -e

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOKS_DIR/.." && pwd)"

# Determine strict mode from env or git config
STRICT_MODE="${STRICT:-$(git config --bool --get hooks.specValidationStrict 2>/dev/null || echo "false")}"

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  PRE-COMMIT VALIDATION PIPELINE"
if [ "$STRICT_MODE" = "true" ]; then
    echo "  Mode: STRICT (all gates must pass)"
else
    echo "  Mode: ADVISORY (warnings only)"
fi
echo "════════════════════════════════════════════════════════════════"
echo ""

VALIDATION_FAILED=0

# Gate 1: Secret scanning with trufflehog (preferred)
echo "Gate 1️⃣  Secret Scanning (trufflehog)..."
if command -v trufflehog &>/dev/null; then
    if trufflehog git file://. --since-commit HEAD --only-verified --fail 2>/dev/null; then
        echo "✅ No secrets detected"
    else
        echo "❌ SECRETS DETECTED!"
        VALIDATION_FAILED=1
        if [ "$STRICT_MODE" = "true" ]; then
            echo "   Commit blocked (STRICT mode)"
        else
            echo "   ⚠️  Warning only (advisory mode)"
        fi
    fi
else
    echo "⚠️  trufflehog not installed. Skipping secret scan."
    echo "   Install: brew install trufflehog"
fi

echo ""

# Gate 2: Spec validation (FR uniqueness, test coverage, traceability)
echo "Gate 2️⃣  Spec Validation (FR↔Test Traceability)..."
if [ -f "$HOOKS_DIR/spec-validator" ]; then
    if bash "$HOOKS_DIR/spec-validator" 2>&1; then
        echo "✅ Spec validation passed"
    else
        VALIDATION_FAILED=1
        if [ "$STRICT_MODE" = "true" ]; then
            echo ""
            echo "❌ SPEC VALIDATION FAILED (STRICT mode)"
            echo ""
            echo "To bypass, use:"
            echo "  git commit --no-verify -m 'message'"
            exit 1
        else
            echo ""
            echo "⚠️  SPEC VALIDATION WARNINGS (advisory mode)"
            echo "   Use --no-verify to bypass, or enable strict mode with:"
            echo "   git config hooks.specValidationStrict true"
        fi
    fi
else
    echo "⚠️  spec-validator not found at $HOOKS_DIR/spec-validator"
fi

echo ""
echo "════════════════════════════════════════════════════════════════"

if [ "$VALIDATION_FAILED" -eq 1 ] && [ "$STRICT_MODE" = "true" ]; then
    echo "❌ PRE-COMMIT VALIDATION FAILED (STRICT MODE)"
    echo "════════════════════════════════════════════════════════════════"
    exit 1
else
    echo "✅ PRE-COMMIT VALIDATION PASSED"
    echo "════════════════════════════════════════════════════════════════"
    exit 0
fi
