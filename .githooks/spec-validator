#!/bin/bash
# Spec validation gate for phenotype-infrakit
# Validates:
# 1. FR IDs are unique (no duplicate FR-XXX-NNN across all repos)
# 2. Every FR in FUNCTIONAL_REQUIREMENTS.md has ≥1 test
# 3. Every test has ≥1 FR reference (e.g., "Traces to: FR-XXX-NNN")
# 4. Blocks commits that violate these rules

set -e

REPO_ROOT="/Users/kooshapari/CodeProjects/Phenotype/repos"
FR_FILE="$REPO_ROOT/FUNCTIONAL_REQUIREMENTS.md"
ERRORS=()
WARNINGS=()

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check 1: FUNCTIONAL_REQUIREMENTS.md exists
if [ ! -f "$FR_FILE" ]; then
    exit 0
fi

# Extract all FR IDs from FUNCTIONAL_REQUIREMENTS.md
ALL_FRS=$(grep -oE "FR-[A-Z]+-[0-9]+" "$FR_FILE" | sort | uniq)
FR_COUNT=$(echo "$ALL_FRS" | grep -c "FR-" || true)

if [ "$FR_COUNT" -eq 0 ]; then
    exit 0
fi

# Check 2: Verify no duplicate FR IDs
DUPLICATES=$(grep -oE "FR-[A-Z]+-[0-9]+" "$FR_FILE" | sort | uniq -d)
if [ -n "$DUPLICATES" ]; then
    ERRORS+=("Found duplicate FR IDs: $DUPLICATES")
fi

# Check 3: Scan test files for FR references
TEST_FILES=$(find "$REPO_ROOT/crates" -type f \( -name "*.rs" -o -name "*.py" -o -name "*.ts" -o -name "*.js" \) 2>/dev/null || true)

TESTED_FRS=()
TESTS_WITH_FR=0
TESTS_WITHOUT_FR=0

for test_file in $TEST_FILES; do
    # Skip non-test files
    if [[ ! "$test_file" =~ (test|spec) ]]; then
        continue
    fi

    if grep -qE "(Traces to:|@trace|@require|pytest\.mark\.requirement)" "$test_file"; then
        TESTS_WITH_FR=$((TESTS_WITH_FR + 1))
        # Extract FR references from this test file
        FILE_FRS=$(grep -oE "FR-[A-Z]+-[0-9]+" "$test_file" | sort | uniq)
        while IFS= read -r fr; do
            if [ -n "$fr" ]; then
                TESTED_FRS+=("$fr")
            fi
        done <<< "$FILE_FRS"
    else
        TESTS_WITHOUT_FR=$((TESTS_WITHOUT_FR + 1))
    fi
done

# Deduplicate tested FRs
TESTED_FRS_UNIQUE=$(printf '%s\n' "${TESTED_FRS[@]}" | sort | uniq)
TESTED_COUNT=$(echo "$TESTED_FRS_UNIQUE" | grep -c "FR-" || true)

if [ "$TESTS_WITHOUT_FR" -gt 0 ]; then
    WARNINGS+=("Found $TESTS_WITHOUT_FR test files without FR references")
fi

# Check 4: Find untested FRs
UNTESTED_FRS=()
MISSING_COVERAGE=0
while IFS= read -r fr; do
    if [ -z "$fr" ]; then
        continue
    fi
    if ! echo "$TESTED_FRS_UNIQUE" | grep -q "^${fr}$"; then
        UNTESTED_FRS+=("$fr")
        MISSING_COVERAGE=$((MISSING_COVERAGE + 1))
    fi
done <<< "$ALL_FRS"

if [ "$MISSING_COVERAGE" -gt 0 ]; then
    ERRORS+=("Found $MISSING_COVERAGE FRs without test coverage")
fi

# Report results
COVERAGE=0
if [ "$FR_COUNT" -gt 0 ]; then
    COVERAGE=$((TESTED_COUNT * 100 / FR_COUNT))
fi

# Handle errors
if [ "${#ERRORS[@]}" -gt 0 ]; then
    exit 1
fi

exit 0
