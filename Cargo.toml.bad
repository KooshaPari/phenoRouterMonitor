[workspace.package]
version = "0.2.0"
edition = "2021"
license = "MIT"
rust-version = "1.75"
authors = ["Phenotype Team"]
repository = "https://github.com/KooshaPari/phenotype-infrakit"
homepage = "https://github.com/KooshaPari/phenotype-infrakit"

[workspace]
resolver = "2"
members = [
    "crates/phenotype-async-traits",
    "crates/phenotype-cache-adapter",
    "crates/phenotype-config-core",
    "crates/phenotype-config-core",
    "crates/phenotype-contracts",
    "crates/phenotype-cost-core",
    "crates/phenotype-crypto",
    "crates/phenotype-error-core",
    "crates/phenotype-errors",
    "crates/phenotype-event-sourcing",
    "crates/phenotype-health",
    "crates/phenotype-http-client-core",
    "crates/phenotype-iter",
    "crates/phenotype-logging",
    "crates/phenotype-macros",
    "crates/phenotype-mcp",
    "crates/phenotype-policy-engine",
    "crates/phenotype-port-traits",
    "crates/phenotype-process",
    "crates/phenotype-rate-limit",
    "crates/phenotype-retry",
    "crates/phenotype-state-machine",
    "crates/phenotype-string",
    "crates/phenotype-telemetry",
    "crates/phenotype-test-infra",
    "crates/phenotype-time",
    "crates/phenotype-validation",
]

exclude = [
    "crates/agileplus-api-types",
    "crates/agileplus-domain",
    "crates/agileplus-error-core",
    "crates/phenotype-git-core",
    "libs/phenotype-config-core",
]

[workspace.dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "2.0"
anyhow = "1.0"
async-trait = "0.1"
chrono = { version = "0.4", features = ["serde"] }
blake3 = "1.5"
dirs = "5.0"
uuid = { version = "1", features = ["v4", "serde"] }
sha2 = "0.10"
aes-gcm = "0.10"
pbkdf2 = "0.12"
rand = "0.8"
hmac = "0.12"
gix = { version = "0.81", default-features = false, features = ["status", "revision", "parallel", "sha1"] }
hex = "0.4"
tokio = { version = "1", features = ["full"] }
dashmap = "5"
parking_lot = "0.12"
lru = "0.12"
moka = { version = "0.12", features = ["sync", "future"] }
regex = "1"
zstd = "0.13"
unicode-normalization = "0.1"
sys-info = "0.9"
toml = "0.8"
reqwest = { version = "0.12", features = ["json"] }
tracing = "0.1"
tracing-subscriber = "0.3"
futures = "0.3"
syn = "2"
quote = "1"
proc-macro2 = "1"
tempfile = "3"
figment = { version = "0.10", features = ["env", "toml"] }
num_cpus = "1.16"
once_cell = "1.19"
phenotype-error-core = { version = "0.2.0", path = "crates/phenotype-error-core" }
phenotype-config-core = { version = "0.2.0", path = "crates/phenotype-config-core" }
phenotype-config-loader = { version = "0.2.0", path = "crates/phenotype-config-core" }

[profile.dev]
opt-level = 0
debug = true

[profile.release]
opt-level = "z"
lto = true
codegen-units = 1
strip = true
