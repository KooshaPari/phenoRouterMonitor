# Taskfile.yml Template for Rust Projects
# Place this file as `Taskfile.yml` in your project root
#
# Usage:
#   1. Copy to project root: cp Taskfile.yml.template /path/to/project/Taskfile.yml
#   2. Install task: https://taskfile.dev/installation/
#   3. Run: task setup

version: '3'

vars:
  PROJECT_NAME: "{{.PROJECT_NAME | default \"{PROJECT_NAME}\"}}"
  CARGO_FLAGS: "--all-features"
  TEST_FLAGS: ""

env:
  RUST_BACKTRACE: 1
  RUST_LOG: debug

tasks:
  default:
    desc: Show available tasks
    cmds:
      - task --list

  setup:
    desc: Setup development environment
    cmds:
      - rustup component add rustfmt clippy
      - cargo install cargo-audit cargo-tarpaulin just
      - cargo build {{.CARGO_FLAGS}}
    silent: true

  build:
    desc: Build the project
    cmds:
      - cargo build {{.CARGO_FLAGS}}
    sources:
      - "src/**/*.rs"
      - "Cargo.toml"

  build-release:
    desc: Build optimized release binary
    cmds:
      - cargo build --release {{.CARGO_FLAGS}}

  test:
    desc: Run all tests
    cmds:
      - cargo test {{.CARGO_FLAGS}} {{.TEST_FLAGS}}

  test-coverage:
    desc: Run tests with coverage report
    cmds:
      - cargo tarpaulin --out Xml --out Html {{.CARGO_FLAGS}}

  lint:
    desc: Run all linters
    cmds:
      - task: fmt-check
      - task: clippy
      - task: audit

  fmt:
    desc: Format code
    cmds:
      - cargo fmt

  fmt-check:
    desc: Check code formatting
    cmds:
      - cargo fmt -- --check

  clippy:
    desc: Run Clippy lints
    cmds:
      - cargo clippy --all-targets {{.CARGO_FLAGS}} -- -D warnings

  audit:
    desc: Audit dependencies for security issues
    cmds:
      - cargo audit

  check:
    desc: Run all checks (format, clippy, test)
    cmds:
      - task: fmt-check
      - task: clippy
      - task: test

  clean:
    desc: Clean build artifacts
    cmds:
      - cargo clean
      - rm -rf target/
      - rm -f coverage.xml coverage.html

  doc:
    desc: Generate documentation
    cmds:
      - cargo doc --no-deps {{.CARGO_FLAGS}}

  doc-open:
    desc: Generate and open documentation
    cmds:
      - cargo doc --no-deps --open {{.CARGO_FLAGS}}

  bench:
    desc: Run benchmarks
    cmds:
      - cargo bench

  update:
    desc: Update dependencies
    cmds:
      - cargo update
      - cargo audit

  ci:
    desc: Run full CI pipeline locally
    cmds:
      - task: fmt-check
      - task: clippy
      - task: test
      - task: audit
      - task: build-release

  release:
    desc: Create a new release
    cmds:
      - cargo build --release
      - echo "Release build complete. Binary in target/release/"
    preconditions:
      - sh: "git diff-index --quiet HEAD"
        msg: "Working directory must be clean"
    interactive: true
