# Rustfmt Configuration Template
# Place this file as `rustfmt.toml` in your project root
#
# Usage:
#   1. Copy to project root: cp rustfmt.toml.template /path/to/project/rustfmt.toml
#   2. Adjust settings per project needs
#   3. Run: cargo fmt
#
# Reference: https://rust-lang.github.io/rustfmt/

# Maximum width of each line
max_width = 100

# Ideal width of each line (as a suggestion)
chain_width = 60

# Number of spaces per tab
# Note: hard_tabs should be false for spaces
tab_spaces = 4
hard_tabs = false

# Unix-style line endings
newline_style = "Unix"

# Brace style for control flow statements
control_brace_style = "AlwaysSameLine"

# Brace style for functions
fn_brace_style = "SameLineWhere"

# Brace style for items
item_brace_style = "SameLineWhere"

# Where to put trailing commas
trailing_comma = "Vertical"

# Where to put trailing semicolons
trailing_semicolon = true

# Add spaces around the '=' in let statements
space_around_eq = true

# Add spaces within type parameters < T >
spaces_within_parens_and_brackets = false

# Remove nested parentheses
remove_nested_parens = true

# Reorder imports alphabetically
reorder_imports = true

# Group imports by std, external crates, then local
group_imports = "StdExternalCrate"

# Reorder module statements alphabetically
reorder_modules = true

# Format strings to fit on one line where possible
format_strings = true

# Format macro bodies
format_macro_bodies = true

# Format macro match arms
format_macro_matchers = true

# Use small heuristic for function arguments
fn_call_width = 60

# Use small heuristic for array literals
array_width = 60

# Use small heuristic for struct literals
struct_lit_width = 18

# Use small heuristic for struct variants
struct_variant_width = 35

# Report all errors instead of just the first
error_on_line_overflow = false
error_on_unformatted = false

# Emit mode (check if files are formatted)
# emit = "files"  # Uncomment for check mode

# Shorten array literals where possible
use_small_heuristics = "Default"

# Indent style
indent_style = "Block"

# Wrap comments at max_width
wrap_comments = true

# Format code in documentation comments
format_code_in_doc_comments = true

# Normalize doc attributes (/// vs #[doc])
normalize_doc_attributes = true

# License template path (optional)
# license_template_path = "LICENSE_TEMPLATE"

# Skip formatting these files/directories
ignore = [
    "target/",
    ".cargo/",
    "**/generated/",
]
