name: CI - Go

on:
  push:
    branches: [main, master]
    paths:
      - '**/*.go'
  pull_request:
    branches: [main, master]
    paths:
      - '**/*.go'

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: golangci/golangci-lint-action@v6
        with:
          version: latest

  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
      - name: Test
        run: go test ./...
