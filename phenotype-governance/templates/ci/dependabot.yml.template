# Standardized Dependabot Configuration
# Place this file as `.github/dependabot.yml` in your project
#
# Usage:
#   1. Copy to .github/: cp dependabot.yml.template /path/to/project/.github/dependabot.yml
#   2. Adjust schedule and ecosystems per project
#   3. Enable Dependabot in GitHub settings
#
# Reference: https://docs.github.com/en/code-security/dependabot/dependabot-version-updates

version: 2
updates:
  # Cargo (Rust) dependencies
  - package-ecosystem: "cargo"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
    open-pull-requests-limit: 10
    reviewers:
      - "@kooshapari"
    labels:
      - "dependencies"
      - "rust"
    commit-message:
      prefix: "chore(deps)"
      include: "scope"
    groups:
      # Group all patch updates
      patch-updates:
        update-types:
          - "patch"
      # Group minor updates (review carefully)
      minor-updates:
        update-types:
          - "minor"
    ignore:
      # Ignore specific packages if needed
      # - dependency-name: "some-crate"
      #   versions: ["0.x"]

  # GitHub Actions
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
    open-pull-requests-limit: 5
    labels:
      - "dependencies"
      - "github-actions"
    commit-message:
      prefix: "ci(deps)"
      include: "scope"

  # npm (if project has JS/TS components)
  # - package-ecosystem: "npm"
  #   directory: "/frontend"
  #   schedule:
  #     interval: "weekly"
  #   open-pull-requests-limit: 5

  # Docker (if project uses Docker)
